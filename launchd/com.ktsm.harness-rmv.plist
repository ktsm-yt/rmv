<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.ktsm.harness-rmv</string>
  <key>ProgramArguments</key>
  <array>
    <string>__RMV_DIR__/launchd/harness-rmv</string>
  </array>
  <key>WorkingDirectory</key>
  <string>__RMV_DIR__</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>LANG</key>
    <string>ja_JP.UTF-8</string>
    <!-- __RMV_DIR__ / __HOME__ は launchd/install.sh が埋める。server が spawn する herdr / orca (/opt/homebrew/bin) を launchd の最小 PATH でも見つけるため -->
    <key>PATH</key>
    <string>__HOME__/.bun/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>StandardOutPath</key>
  <string>__HOME__/Library/Logs/harness-rmv.log</string>
  <key>StandardErrorPath</key>
  <string>__HOME__/Library/Logs/harness-rmv.log</string>
</dict>
</plist>
